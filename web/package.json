{
  "name": "agclaw-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "dev:lan": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start",
    "start:lan": "next start -H 0.0.0.0 -p 3000",
    "lint": "next lint",
    "type-check": "next build --no-lint",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "android:usb:setup": "powershell -ExecutionPolicy Bypass -File ./scripts/android-usb-setup.ps1",
    "selenium:smoke": "node ./scripts/selenium-smoke.mjs",
    "selenium:smoke:mobile": "node ./scripts/selenium-smoke.mjs --mobile",
    "appium:android:smoke": "node ./scripts/appium-android-smoke.mjs",
    "browserstack:mobile:smoke": "node ./scripts/browserstack-mobile-smoke.mjs",
    "audit:ui": "impeccable",
    "audit:chat-shell": "powershell -ExecutionPolicy Bypass -File ../scripts/run-impeccable-web-audit.ps1 -Preset chat-shell",
    "audit:buddy": "powershell -ExecutionPolicy Bypass -File ../scripts/run-impeccable-web-audit.ps1 -Preset buddy",
    "audit:settings": "powershell -ExecutionPolicy Bypass -File ../scripts/run-impeccable-web-audit.ps1 -Preset settings",
    "audit:url:home": "node ./scripts/run-impeccable-url-audit.mjs http://127.0.0.1:3000/"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.5",
    "@radix-ui/react-collapsible": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-select": "^2.1.0",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.0",
    "@radix-ui/react-tooltip": "^1.1.0",
    "@tanstack/react-virtual": "^3.8.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.400.0",
    "nanoid": "^5.0.0",
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^9.0.0",
    "remark-gfm": "^4.0.0",
    "shiki": "^1.10.0",
    "swr": "^2.2.0",
    "tailwind-merge": "^2.3.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^14.2.0",
    "@playwright/test": "^1.59.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10",
    "browserstack-local": "^1.5.13",
    "eslint": "^8",
    "eslint-config-next": "^14.2.0",
    "browserstack-local": "^1.5.6",
    "impeccable": "^2.1.7",
    "postcss": "^8",
    "puppeteer": "^24.40.0",
    "selenium-webdriver": "^4.43.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5"
  }
}
